# ==============================================================================
# Roxstar AI Voice Room Assistant - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual credentials:
#   cp .env.example .env
#
# Cost Requirement:
# All services below are ₹0-cost free tier or open source:
# - LiveKit Cloud: Free tier developer project (or local LiveKit server)
# - OpenRouter: Free tier models (e.g. openrouter/free)
# - Groq: Free tier Whisper API (whisper-large-v3-turbo)
# ==============================================================================

# LiveKit Cloud or self-hosted server credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# OpenRouter API (free tier LLM models)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Groq Cloud API (free tier Whisper STT)
GROQ_API_KEY=your_groq_api_key
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_LANGUAGE=hi

# Local TTS Configuration (₹0-cost open-source Piper Hindi/Hinglish TTS)
# Fully local ONNX inference on Apple Silicon / CPU - No API key required
TTS_MODEL=hi_IN-rohan-medium
TTS_DEVICE=cpu
TTS_SAMPLE_RATE=22050
TTS_AUTO_DOWNLOAD=true
# Optional custom paths (if pre-downloaded):
# TTS_MODEL_PATH=models/hi_IN-rohan-medium.onnx
# TTS_CONFIG_PATH=models/hi_IN-rohan-medium.onnx.json

# Application Logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

